{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "candidate_manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate_id",
    "lane",
    "prompt_files"
  ],
  "properties": {
    "candidate_id": {
      "type": "string"
    },
    "lane": {
      "type": "string",
      "enum": [
        "review",
        "dispatcher",
        "hooks"
      ]
    },
    "prompt_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    },
    "metadata": {
      "type": "object"
    }
  }
}
