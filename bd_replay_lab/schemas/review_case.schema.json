{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "review_case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "lane",
    "packet_version",
    "input",
    "expected"
  ],
  "properties": {
    "case_id": {
      "type": "string"
    },
    "lane": {
      "const": "review",
      "type": "string"
    },
    "packet_version": {
      "type": "string"
    },
    "input": {
      "type": "object",
      "required": [
        "pr_meta",
        "diff_summary",
        "verify_summary",
        "worker_status_v2",
        "scope_dod",
        "merge_state"
      ],
      "additionalProperties": true
    },
    "expected": {
      "type": "object",
      "required": [
        "decision",
        "findings"
      ],
      "properties": {
        "decision": {
          "type": "string",
          "enum": [
            "approve",
            "request_changes",
            "block_merge"
          ]
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "type",
              "severity"
            ],
            "properties": {
              "type": {
                "type": "string"
              },
              "severity": {
                "type": "string",
                "enum": [
                  "low",
                  "medium",
                  "high"
                ]
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "metadata": {
      "type": "object"
    }
  }
}
