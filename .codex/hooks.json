{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/codex_hooks/autoresearch_session_start.py\"",
            "timeout": 5,
            "statusMessage": "Autoresearch guard"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/codex_hooks/autoresearch_stop.py\"",
            "timeout": 5,
            "statusMessage": "Autoresearch stop guard"
          }
        ]
      }
    ]
  }
}
